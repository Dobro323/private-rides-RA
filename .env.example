# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key   # NEVER expose to client

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token                 # from @BotFather
TELEGRAM_ADMIN_CHAT_ID=your_chat_id               # your personal chat ID

# Resend (email)
RESEND_API_KEY=re_your_key
RESEND_FROM_EMAIL=rides@yourdomain.com

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Zelle
ZELLE_PHONE=+19165550000                          # your Zelle number
ZELLE_NAME=Rich Alter                             # name on Zelle

# App
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
ADMIN_SECRET=a_long_random_string                 # protects /admin route

# Optional: max service radius (miles)
SERVICE_RADIUS_MILES=50
